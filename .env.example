# Copy to .env and adjust as needed.

DATABASE_URL=postgresql+asyncpg://buysmarter:buysmarter@localhost:5434/buysmarter
REDIS_URL=redis://localhost:6380/0

# LLM: primary provider is the local `claude` CLI through OmniRoute (the model
# picks the combo; only opus/hard puts the Claude subscription first) — NO API key required. The keys below are an optional API fallback,
# used only when you set DEFAULT_LLM_MODEL to a non-CLI model that has its key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# LLM adapter defaults. haiku/sonnet/opus route to the local `claude` CLI.
DEFAULT_LLM_MODEL=sonnet
PROMPT_VERSION=v1

# Kaspi.kz source (optional; residential proxy for datacenter IPs Kaspi 429s).
KASPI_PROXY=
